# Copie este arquivo para .env e preencha com valores reais.
# .env nunca é versionado (ver .gitignore) — é a única fonte de segredos do backend.

# Senha do usuário postgres (usada pelo container db e embutida nas connection strings abaixo)
POSTGRES_PASSWORD=changeme

# Connection string completa (host=db dentro da rede Docker do docker-compose deste repo)
ConnectionStrings__MasterConnection=Host=db;Database=easypizza_master;Username=postgres;Password=changeme

# Chave simétrica de assinatura do JWT de staff (lojista/master) — mínimo 32 caracteres
Jwt__Key=changeme-troque-por-uma-chave-longa-e-aleatoria

# Senha do usuário Master padrão, criado automaticamente no primeiro boot (ver DatabaseSeeder)
MasterDefault__Password=changeme
