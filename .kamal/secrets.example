# Copie este arquivo para .kamal/secrets e preencha com valores reais.
# .kamal/secrets nunca é versionado (ver .gitignore) — fica só na sua máquina.

# Mesmo Personal Access Token do GHCR já usado em nathanbraz.dev/.kamal/secrets
# (mesma conta "nathanbraz" no registry) — pode copiar o mesmo valor de lá.
KAMAL_REGISTRY_PASSWORD=

# Senha do usuário postgres da instância NOVA que vai rodar na VPS (accessory do
# Kamal) — não precisa (e não deve) ser igual à senha do Postgres local de dev.
POSTGRES_PASSWORD=

# Connection string completa do Banco Master, apontando pro accessory acima.
# Host fixo "easypizzab-homolog-postgres" — é o nome de container que o Kamal cria
# sozinho a partir do service+accessory deste deploy.yml, não precisa criar nada à mão.
# Sugestão de nome de banco "easypizza_master" (mesmo padrão do .env local) — é criado
# automaticamente no primeiro boot (EF Core Migrate), não precisa criar antes.
ConnectionStrings__MasterConnection=Host=easypizzab-homolog-postgres;Port=5432;Database=easypizza_master;Username=postgres;Password=<mesma senha do POSTGRES_PASSWORD acima>

# Chave simétrica de assinatura do JWT de staff (lojista/master) — mínimo 32
# caracteres, recomendado gerar uma nova (não reaproveitar a de dev local).
Jwt__Key=

# Senha do usuário Master padrão, criado automaticamente no primeiro boot deste
# ambiente (ver DatabaseSeeder) — recomendado gerar uma nova.
MasterDefault__Password=

# Template de connection string usado automaticamente ao cadastrar uma loja nova no
# painel Master (ver TenantsController.Create) — o "{slug}" é substituído pelo
# identificador da loja. Preenchendo isso, o campo de ConnectionString do formulário
# de cadastro fica realmente opcional (não precisa digitar nada por loja).
Tenant__DefaultConnectionStringTemplate=Host=easypizzab-homolog-postgres;Port=5432;Database=easypizza_{slug};Username=postgres;Password=<mesma senha do POSTGRES_PASSWORD acima>
